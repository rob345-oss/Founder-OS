{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_FOS_APP_TRACK": "development",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview-lab": {
      "distribution": "internal",
      "channel": "preview-lab",
      "env": {
        "EXPO_PUBLIC_FOS_APP_TRACK": "lab",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    }
  },
  "submit": {}
}
