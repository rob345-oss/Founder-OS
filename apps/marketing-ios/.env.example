# Founder OS Dev (local Expo / simulator) — copy to .env and fill in.
# For Lab UI locally: EXPO_PUBLIC_FOS_APP_TRACK=lab

EXPO_PUBLIC_FOS_APP_TRACK=development
EXPO_PUBLIC_APP_ENV=development

# Supabase Auth (anon key only — never service role)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Founder OS API (Cloud Run or local uvicorn)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Apple Developer (set via scripts/ios/Set-FounderOSAppleEnvironment.ps1 — do not commit passwords)
# APPLE_ID=robertdsicora@gmail.com
# EXPO_APPLE_ID=robertdsicora@gmail.com
# APPLE_TEAM_ID=T3KM8V39H7
# EXPO_APPLE_TEAM_ID=T3KM8V39H7

# Do NOT set: SUPABASE_SERVICE_ROLE_KEY, EXPO_ACCESS_TOKEN, TG bundle vars, EXPO_PUBLIC_TG_APP_TRACK
