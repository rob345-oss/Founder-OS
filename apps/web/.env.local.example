# Founder OS Studio — local media boundary (required for Titanium Guardian workflow)
# Use your verified absolute path (do not commit real paths if this file is shared).
# Required — absolute path to your commercial footage folder (e.g. Titanium Guardian Commercial)
FOUNDER_OS_STUDIO_MEDIA_ROOT=

# Optional: when FFmpeg is not on PATH (e.g. winget Gyan.FFmpeg)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# Optional: SQLite + thumbnails (defaults to %LOCALAPPDATA%\FounderOS\Studio)
# FOUNDER_OS_STUDIO_DATA_DIR=

# Production local server only (next start on your PC)
# STUDIO_ENABLE_LOCAL_FS=true

# Loopback-only local owner (infrastructure APIs without Supabase sign-in)
# FOUNDER_OS_LOCAL_OWNER_MODE=true
# NEXT_PUBLIC_FOUNDER_OS_LOCAL_OWNER_MODE=true
# Optional hardening (mirror as NEXT_PUBLIC_FOUNDER_OS_LOCAL_OWNER_TOKEN in browser)
# FOUNDER_OS_LOCAL_OWNER_TOKEN=

# Optional explicit project roots (comma-separated); defaults include Founder OS checkout
# FOUNDER_OS_APPROVED_PROJECT_ROOTS=C:\path\to\Founder-OS,C:\path\to\senior-cybersecurity-346

# Optional loopback hardening (server secret; mirror in NEXT_PUBLIC_STUDIO_LOCAL_TOKEN for the browser)
# STUDIO_LOCAL_TOKEN=

# OpenAI — server-only (Next.js reads apps/web/.env.local; never commit; never expose to client bundles)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REQUEST_TIMEOUT_MS=120000

# --- Infrastructure command center (server-only; see root .env.example) ---
# NEXT_PUBLIC_SUPABASE_URL=https://nigmbsibxmcycwektwth.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=                  # Supabase Dashboard → API → anon or publishable key
# SUPABASE_URL=                                    # mirror NEXT_PUBLIC_SUPABASE_URL (server guard)
# SUPABASE_ANON_KEY=                               # mirror anon key (server guard)
# FOUNDER_USER_IDS=                                # your Supabase Auth user UUID
# EXPO_ACCESS_TOKEN=                  # required in THIS file (apps/web) — Next.js does not load repo-root .env.local
# INFRASTRUCTURE_DATABASE_URL=                     # founder_os_diag read-only URL
# INFRASTRUCTURE_TG_REPO_PATH=
# INFRASTRUCTURE_TG_GIT_COMMIT=                   # must match `git rev-parse HEAD` in TG checkout (Development fixes; Lab binary baseline remains EAS 0b37c87)
# INFRASTRUCTURE_EAS_BUILD_ENABLED=false
# INFRASTRUCTURE_EAS_EXECUTE_BUILDS=false          # keep false for validation-only; never leave true permanently
# Mobile Builds UI confirmation phrases (server-enforced):
#   RUN-TRACK-VALIDATION — queues validation job (no billable EAS)
#   START-BILLABLE-BUILD — requires INFRASTRUCTURE_EAS_EXECUTE_BUILDS=true + EXPO_ACCESS_TOKEN
# INFRASTRUCTURE_EAS_LAB_BUILDS_ALLOWED=false   # separate gate for Lab billable EAS (preserved baseline)
# TITANIUM_GUARDIAN_STAGING_BEARER_TOKEN=

# --- CRM (super_admin only; server-side Postgres recommended on staging) ---
# CRM_DATABASE_URL=postgresql://founder_os_app:PASSWORD@db.nigmbsibxmcycwektwth.supabase.co:5432/postgres
# FOUNDER_OS_CRM_DATA_DIR=                      # local SQLite fallback when CRM_DATABASE_URL unset
# CRM_TG_API_BASE_URL=                          # defaults to TITANIUM_GUARDIAN_STAGING_API_URL
# CRM_TG_SYNC_BEARER_TOKEN=                     # server-only TG token for cron sync (list leads)
# CRM_CRON_SECRET=                              # protects /api/crm/cron/sync-waitlist (Vercel may use CRON_SECRET)
# CRM_EMAIL_WEBHOOK_SECRET=                     # HMAC for /api/crm/webhooks/email
# CRM_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=        # optional ECDSA public key (Twilio Email Event / SendGrid)
# CRM_EMAIL_TRACK_ENGAGEMENT=false            # ignore open/click unless true (privacy)
# CRM_WAITLIST_SYNC_INTERVAL_MINUTES=5

# --- Marketing Command Center (super_admin; shares CRM_DATABASE_URL on staging) ---
# MARKETING_DATABASE_URL=                         # optional override; defaults to CRM_DATABASE_URL
# MARKETING_GA4_PROPERTY_ID=                      # server-only — no live GA4 pull until integration layer ships
# MARKETING_GA4_CREDENTIALS_JSON=                 # service account JSON (server only; never expose to browser)
# MARKETING_GSC_SITE_URL=                         # e.g. sc-domain:titaniumguardian.com
# MARKETING_BUSINESS_TIMEZONE=Europe/Madrid
