# Founder OS — copy to .env and fill in (never commit .env)
# Shared Supabase project (Titanium Guardian production project — use dedicated keys)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-only: never use service role in browser. Founder OS API uses minimal DB role via DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=

# Founder OS API (Cloud Run)
DATABASE_URL=postgresql+asyncpg://founder_os_app:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=

# Comma-separated Supabase Auth user UUIDs allowed to use Founder OS
FOUNDER_USER_IDS=

# Optional: comma-separated emails (must match JWT email claim)
FOUNDER_EMAIL_ALLOWLIST=

OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# API CORS (production): comma-separated origins
CORS_ORIGINS=

# Web (Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Founder OS Studio (local Next.js server only — not Vercel)
# FOUNDER_OS_STUDIO_DATA_DIR=C:\Users\you\AppData\Local\FounderOS\Studio
# STUDIO_ENABLE_LOCAL_FS=true
# STUDIO_LOCAL_TOKEN=choose-a-long-random-string
# NEXT_PUBLIC_STUDIO_LOCAL_TOKEN=same-as-above-if-you-want-browser-to-send-it
